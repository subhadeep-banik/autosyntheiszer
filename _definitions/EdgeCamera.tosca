tosca_definitions_version: tosca_simple_yaml_1_3

imports:
  - file: .tosca
    namespace_uri: MYRTUS-mobility
    namespace_prefix: MYRTUS-

node_types:
  compute_nodes.EdgeCamera:

    metadata:
      targetNamespace: "MYRTUS-mobility"
      abstract: "false"
      final: "true"
    properties:
      processingCapability:
      	type: string
      	
      memory:
      	type: string
      	
      networkBandwidth:
      	type: string
      	
      cameraSensorSpec:
      	type: string
      	
      location:
      	type: string
      	
      cpuUtilization:
      	type: float
      	
      frame_rate:
      	type: integer
      	
      baselineAveragePowerConsumption:
      	type: float
      	
      minPowerConsumptionThreshold:
      	type: float
      	
      maxPowerConsumptionThreshold:
      	type: float
      	
      lowPowerMode:
      	type: boolean
      	
    capabilities:
      host:
        occurrences: [ 0, 0 ]
        type: tosca.capabilities.Compute
