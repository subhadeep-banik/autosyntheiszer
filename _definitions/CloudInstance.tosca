tosca_definitions_version: tosca_simple_yaml_1_3

imports:
  - file: .tosca
    namespace_uri: MYRTUS-Mobility
    namespace_prefix: MYRTUS-

node_types:
  compute_nodes.CloudInstance:

    metadata:
      targetNamespace: "MYRTUS-Mobility"
      abstract: ""
      final: ""
    properties:
      processingCapabilities:
      	type: string
      	
      memory:
      	type: string
      	
      networkBandwidth:
      	type: string
      	
      storageCapacity:
      	type: string
      	
      highCpuThreshold:
      	type: float
      	
    capabilities:
      host:
        occurrences: [ 0, 0 ]
        type: tosca.capabilities.Compute
